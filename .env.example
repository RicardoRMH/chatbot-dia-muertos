# Credenciales de Supabase para registrar las interacciones del chatbot.
# Copia este archivo a .env.local y rellena los valores. NO subas .env.local a Git.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Publishable key (la clave `anon` / public).
# Nunca uses aquí la clave `service_role`: es secreta y no debe ir en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
